--source mysql_test/test_suite/file_sql/include/file_sql_setup.inc
SELECT @@enable_file_sql;
--error ER_NOT_SUPPORTED_YET
eval SELECT * FROM read_csv('$file_sql_dir/users.csv');
SET enable_file_sql=ON;
eval SELECT id, name, amount * 2 AS doubled FROM read_csv('$file_sql_dir/users.csv') AS u WHERE active = true ORDER BY id LIMIT 2;
eval SELECT team, COUNT(*) AS n, COUNT(amount) AS nonnull, SUM(amount) AS total, AVG(amount) AS mean, MIN(amount) AS lo, MAX(amount) AS hi FROM read_csv('$file_sql_dir/users.csv') GROUP BY team HAVING COUNT(*) > 1 ORDER BY team;
eval DESCRIBE SELECT * FROM read_csv('$file_sql_dir/users.csv');
eval SELECT * FROM read_ndjson('$file_sql_dir/teams.jsonl') ORDER BY team;
eval SELECT id, value FROM read_parquet('$file_sql_dir/numbers.parquet') ORDER BY id;
eval SELECT COUNT(*) FROM glob('$file_sql_dir/*.csv');
eval SELECT u.id, t.label FROM read_csv('$file_sql_dir/users.csv') u INNER JOIN read_json('$file_sql_dir/teams.jsonl') t ON u.team=t.team ORDER BY u.id;
eval SELECT t.team, COUNT(u.id) AS n FROM read_json('$file_sql_dir/teams.jsonl') t LEFT JOIN read_csv('$file_sql_dir/users.csv') u ON t.team=u.team GROUP BY t.team ORDER BY t.team;
eval SELECT p.id, u.name FROM read_parquet('$file_sql_dir/numbers.parquet') p LEFT JOIN read_csv('$file_sql_dir/users.csv') u ON p.id=u.id ORDER BY p.id;
eval EXPLAIN SELECT u.id FROM read_csv('$file_sql_dir/users.csv') u JOIN read_json('$file_sql_dir/teams.jsonl') t ON u.team=t.team;
eval COPY (SELECT id, name, amount FROM read_csv('$file_sql_dir/users.csv') ORDER BY id) TO '$file_sql_dir/export.csv' (FORMAT CSV, HEADER, DELIMITER ';', QUOTE '"', ESCAPE '"', NULL 'NA');
eval SELECT id, name, amount FROM read_csv('$file_sql_dir/export.csv', delimiter=';', nullstr='NA') ORDER BY id;
--error ER_NOT_SUPPORTED_YET
eval COPY (SELECT 1 AS id) TO '$file_sql_dir/export.csv';
--error ER_NOT_SUPPORTED_YET
eval SELECT * FROM read_csv('$file_sql_dir/bad.csv');
--error ER_NOT_SUPPORTED_YET
eval SELECT * FROM read_json('$file_sql_dir/nested.jsonl');
--error ER_NOT_SUPPORTED_YET
eval SELECT * FROM read_csv('$file_sql_dir/users.csv', sample_size=1);
SELECT 1 + 2 AS ordinary_sql;
--source mysql_test/test_suite/file_sql/include/file_sql_cleanup.inc
